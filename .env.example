# ===== Variante 1: Google Gemini (KOSTENLOS, empfohlen) =====
# Kostenlosen Key holen (ohne Kreditkarte): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ===== Variante 2: Ollama (KOSTENLOS, läuft offline auf deinem PC) =====
# Ollama installieren (https://ollama.com), dann einmal: ollama pull llama3.2
# Und hier die Raute vor PROVIDER entfernen:
# PROVIDER=ollama
# OLLAMA_MODEL=llama3.2

# ===== Variante 3: Claude (kostenpflichtig, sehr gute Antworten) =====
# Key holen: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-5-5

# ===== Optional =====
# USER_NAME=Sir
# PORT=3000

# ===== Optional: natürliche Stimme mit Fish Audio =====
# Key holen: https://fish.audio/app/api-keys
# Stimme aussuchen auf https://fish.audio (z. B. nach "Jarvis" suchen) und die ID aus der Adresse kopieren
# FISH_API_KEY=
# FISH_VOICE_ID=
# FISH_MODEL=s2.1-pro-free
# Deine Stadt für Wetter und Anzeige
# CITY=Berlin
# Sprechtempo der Stimme (0.5 bis 2.0)
# FISH_SPEED=1.1
